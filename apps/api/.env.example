NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://employee_saas:employee_saas@localhost:5432/employee_saas?schema=public"

# Signs/verifies access tokens (JWTs). Refresh tokens are random opaque
# strings stored hashed in the DB, so they don't need a signing secret.
# Must be at least 32 characters.
JWT_ACCESS_SECRET=dev-insecure-access-token-signing-secret-please-change

# File storage - "local" (default, dev/test) writes under STORAGE_LOCAL_PATH
# and serves downloads through this API; "s3" uses the S3_* settings below.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage-data
# Signs the short-lived (5 min) download tokens the "local" driver hands
# out. Must be at least 32 characters.
FILE_TOKEN_SECRET=dev-insecure-file-token-signing-secret-please-change

# Only read when STORAGE_DRIVER=s3. In dev, the API runs on the host
# (pnpm dev), so S3_ENDPOINT is localhost. S3_PUBLIC_URL is used only to
# presign download URLs returned to clients - set it to your machine's LAN
# IP (e.g. http://192.168.1.50:9000) so the Expo app on a phone can reach it.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=employee-saas
