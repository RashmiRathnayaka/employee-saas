NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://employee_saas:employee_saas@localhost:5432/employee_saas?schema=public"

JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please

# In dev, the API runs on the host (pnpm dev), so S3_ENDPOINT is localhost.
# S3_PUBLIC_URL is used only to presign download URLs returned to clients -
# set it to your machine's LAN IP (e.g. http://192.168.1.50:9000) so the
# Expo app on a phone can reach it.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=employee-saas
