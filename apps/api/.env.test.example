# Used only by `pnpm test` (apps/api). Points at a separate database so
# tests never touch dev data. See README "Running tests" for setup.
NODE_ENV=test
PORT=4001

DATABASE_URL="postgresql://employee_saas:employee_saas@localhost:5432/employee_saas_test?schema=public"

JWT_ACCESS_SECRET=test-insecure-access-token-signing-secret-not-for-real-use

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=employee-saas-test
