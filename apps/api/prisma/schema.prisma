generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String        @id @default(uuid())
  name      String
  code      String        @unique
  logoUrl   String?
  status    CompanyStatus @default(ACTIVE)
  timezone  String        @default("Asia/Colombo")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  settings              CompanySettings?
  departments           Department[]
  designations          Designation[]
  employees             Employee[]
  users                 User[]
  leaveTypes            LeaveType[]
  holidays              CompanyHoliday[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  leaveApprovals        LeaveApproval[]
  leaveRequestDocuments LeaveRequestDocument[]
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@map("companies")
}

model CompanySettings {
  companyId                  String                @id
  company                    Company               @relation(fields: [companyId], references: [id])
  leaveApprovalWorkflow      LeaveApprovalWorkflow @default(MANAGER_ONLY)
  sickLeaveProofDeadlineDays Int                   @default(3)
  gpsCheckinEnabledDefault   Boolean               @default(false)
  gpsRadiusMeters            Int                   @default(200)
  employeeIdPrefix           String                @default("EMP-")
  employeeIdNextNumber       Int                   @default(1)
  enabledModules             Json                  @default("{}")
  workingDays                Json                  @default("{\"mon\":\"FULL\",\"tue\":\"FULL\",\"wed\":\"FULL\",\"thu\":\"FULL\",\"fri\":\"FULL\",\"sat\":\"HALF\",\"sun\":\"OFF\"}")
  updatedAt                  DateTime              @updatedAt

  @@map("company_settings")
}

model Department {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  employees Employee[]

  // Case-insensitive uniqueness ("Engineering" vs "engineering") is enforced
  // by a functional unique index added by hand in the migration SQL - see
  // migrations/*_case_insensitive_names/migration.sql - since Prisma's
  // schema DSL can't express a functional (lower()) index.
  @@index([companyId])
  @@map("departments")
}

model Designation {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  employees Employee[]

  // Case-insensitive uniqueness enforced by a hand-written functional unique
  // index in the migration SQL - see Department above for why.
  @@index([companyId])
  @@map("designations")
}

model Employee {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  employeeCode  String
  firstName     String
  lastName      String
  photoUrl      String?
  phone         String?
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  designationId String?
  designation   Designation?   @relation(fields: [designationId], references: [id])
  managerId     String?
  manager       Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  reports       Employee[]     @relation("EmployeeManager")
  joiningDate   DateTime       @db.Date
  status        EmployeeStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User?
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[] @relation("EmployeeLeaveRequests")

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([companyId, managerId])
  @@map("employees")
}

model User {
  id           String     @id @default(uuid())
  companyId    String?
  company      Company?   @relation(fields: [companyId], references: [id])
  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  email        String?
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  mustChangePassword Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens        RefreshToken[]
  notifications        Notification[]
  auditLogs            AuditLog[]             @relation("AuditLogActor")
  leaveApprovals       LeaveApproval[]        @relation("LeaveApprovalApprover")
  revokedLeaveRequests LeaveRequest[]         @relation("LeaveRequestRevokedBy")
  reviewedDocuments    LeaveRequestDocument[] @relation("DocumentReviewer")

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  userAgent         String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model LeaveType {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  name                String
  code                String
  defaultAnnualDays   Decimal  @db.Decimal(5, 2)
  requiresProof       Boolean  @default(false)
  carryForwardAllowed Boolean  @default(false)
  // Submitting a request with startDate in the past is normally rejected;
  // this allows it (e.g. sick leave filed the morning after) - bounded to
  // 30 days back regardless, enforced in the service layer.
  allowPastDates      Boolean  @default(false)
  createdAt           DateTime @default(now())

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("leave_types")
}

model CompanyHoliday {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  date      DateTime @db.Date
  name      String

  @@unique([companyId, date])
  @@map("company_holidays")
}

model LeaveBalance {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId     String
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  year            Int
  allocatedDays   Decimal   @db.Decimal(6, 2)
  usedDays        Decimal   @default(0) @db.Decimal(6, 2)
  pendingDays     Decimal   @default(0) @db.Decimal(6, 2)
  carriedOverDays Decimal   @default(0) @db.Decimal(6, 2)
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String             @id @default(uuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  employeeId   String
  employee     Employee           @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id])
  leaveTypeId  String
  leaveType    LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  startHalfDay Boolean            @default(false)
  endHalfDay   Boolean            @default(false)
  totalDays    Decimal            @db.Decimal(5, 2)
  reason       String?
  status       LeaveRequestStatus
  proofStatus  ProofStatus        @default(NOT_REQUIRED)
  proofDueAt   DateTime?
  revokedById  String?
  revokedBy    User?              @relation("LeaveRequestRevokedBy", fields: [revokedById], references: [id])
  revokedAt    DateTime?
  revokeNote   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  approvals LeaveApproval[]
  documents LeaveRequestDocument[]

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@index([proofDueAt])
  @@map("leave_requests")
}

model LeaveApproval {
  id             String           @id @default(uuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  leaveRequestId String
  leaveRequest   LeaveRequest     @relation(fields: [leaveRequestId], references: [id])
  step           ApprovalStep
  approverUserId String
  approver       User             @relation("LeaveApprovalApprover", fields: [approverUserId], references: [id])
  decision       ApprovalDecision
  note           String?
  decidedAt      DateTime         @default(now())

  @@unique([leaveRequestId, step])
  @@index([leaveRequestId])
  @@index([approverUserId])
  @@map("leave_approvals")
}

model LeaveRequestDocument {
  id             String         @id @default(uuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  leaveRequestId String
  leaveRequest   LeaveRequest   @relation(fields: [leaveRequestId], references: [id])
  objectKey      String
  filename       String
  contentType    String
  sizeBytes      Int
  status         DocumentStatus @default(PENDING_REVIEW)
  reviewedById   String?
  reviewedBy     User?          @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  uploadedAt     DateTime       @default(now())

  @@index([leaveRequestId])
  @@map("leave_request_documents")
}

model Notification {
  id                String    @id @default(uuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  type              String
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([companyId, userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  actorUserId String?
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum LeaveApprovalWorkflow {
  MANAGER_ONLY
  MANAGER_THEN_HR
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
}

enum ProofStatus {
  NOT_REQUIRED
  MISSING
  SUBMITTED
  ACCEPTED
  REJECTED
  INFO_REQUIRED
}

enum ApprovalStep {
  MANAGER
  HR
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum DocumentStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  INFO_REQUIRED
}
