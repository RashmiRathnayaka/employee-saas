# Copy to .env and set this to your computer's LAN IP (not localhost/127.0.0.1
# - your phone needs to reach your computer over Wi-Fi). Find it with
# `ipconfig` on Windows (the "IPv4 Address" under your active Wi-Fi adapter).
# See the README's "Run the app on your phone" section for the full walkthrough.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api/v1
