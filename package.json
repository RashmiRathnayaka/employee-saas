{
  "name": "employee-saas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @employee-saas/api --filter @employee-saas/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @employee-saas/api db:migrate",
    "db:seed": "pnpm --filter @employee-saas/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "typescript-eslint": "^8.8.1"
  }
}
